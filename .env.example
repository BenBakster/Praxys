# GEMINI_API_KEY: ключ Google Gemini для формування висновків.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_PASSWORD: пароль входу, не коротше 8 символів.
# На Railway обов'язковий: без нього сервер не запускається.
# Локально можна не задавати — тоді програма відкривається лише на цьому комп'ютері.
APP_PASSWORD=""

# BOT_TOKEN: токен Telegram-бота (@BotFather) для надсилання висновку DOCX у чат лікаря.
BOT_TOKEN=""

# ADMIN_ID: особистий Telegram Chat ID лікаря (наприклад, з @userinfobot).
ADMIN_ID=""
